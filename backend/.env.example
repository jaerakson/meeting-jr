# Hugging Face 토큰 (PyAnnote 모델 접근용, 필수)
# https://huggingface.co/settings/tokens 에서 발급
HF_TOKEN=hf_your_token_here

# Notion API 연동 (선택)
NOTION_API_KEY=
NOTION_DATABASE_ID=

# 서버 포트
PORT=8000

# 파일 업로드 제한 (MB)
MAX_UPLOAD_MB=500

# CORS 허용 출처 (쉼표로 구분, 외부 접속 시 프론트엔드 주소 추가)
# 예: ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.100:3000
ALLOWED_ORIGINS=http://localhost:3000
